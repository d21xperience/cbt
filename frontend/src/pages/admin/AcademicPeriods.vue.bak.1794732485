<template>
  <q-page padding>
    <!-- Header -->
    <div class="row justify-between items-center q-mb-md">
      <div>
        <div class="text-h5 text-weight-bold">
          <q-icon name="calendar_month" color="primary" size="sm" class="q-mr-sm" />
          Tahun Ajaran
        </div>
        <div class="text-caption text-grey-7">
          Kelola periode akademik. Tahun ajaran menjadi konteks global semua data.
        </div>
      </div>
      <q-btn color="primary" icon="add" label="Buat Tahun Ajaran Baru" no-caps @click="openCreateDialog" />
    </div>

    <!-- Info banner -->
    <q-banner dense rounded class="bg-blue-1 text-blue-9 q-mb-md">
      <template v-slot:avatar><q-icon name="info" color="primary" /></template>
      Saat membuat tahun ajaran baru, sistem otomatis menyalin kelas, siswa, dan pembelajaran dari periode aktif dengan
      <b>auto-naik-tingkat</b>. Siswa tingkat akhir diarsipkan (lulus).
    </q-banner>

    <!-- Table -->
    <q-card flat bordered class="bg-white">
      <q-table :rows="periods" :columns="columns" row-key="id" flat :loading="loading"
        no-data-label="Belum ada tahun ajaran">
        <template v-slot:body-cell-status="props">
          <q-td :props="props" class="text-center">
            <q-badge :color="props.row.is_active ? 'positive' : 'grey-6'"
              :label="props.row.is_active ? 'AKTIF' : 'Tidak Aktif'" class="q-px-sm" />
          </q-td>
        </template>

        <template v-slot:body-cell-actions="props">
          <q-td :props="props" class="text-center" style="white-space: nowrap">
            <q-btn v-if="!props.row.is_active" flat dense no-caps icon="check_circle" color="primary" label="Aktifkan"
              @click="confirmActivate(props.row)" />
            <span v-else class="text-caption text-grey-6">—</span>
          </q-td>
        </template>
      </q-table>
    </q-card>

    <!-- Create Dialog -->
    <q-dialog v-model="createDialogOpen" persistent>
      <q-card style="min-width: 420px; max-width: 95vw">
        <q-card-section class="bg-primary text-white">
          <div class="text-h6">Buat Tahun Ajaran Baru</div>
          <div class="text-caption">Semua data akan di-copy dari periode aktif</div>
        </q-card-section>

        <q-card-section class="q-gutter-md">
          <q-input v-model="form.academic_year" label="Tahun Ajaran (Format: YYYY/YYYY)" outlined dense
            placeholder="2027/2028" :rules="[(v) => /^\d{4}\/\d{4}$/.test(v) || 'Format harus YYYY/YYYY']" />
          <q-select v-model="form.semester" :options="semesterOptions" label="Semester" outlined dense emit-value
            map-options />
          <q-banner v-if="activePeriod" dense rounded class="bg-orange-1 text-orange-9">
            <template v-slot:avatar><q-icon name="warning" /></template>
            Akan copy dari periode aktif: <b>{{ activePeriod.academic_year }} — {{ activePeriod.semester }}</b>
          </q-banner>
        </q-card-section>

        <q-card-actions align="right" class="q-pb-md q-pr-md">
          <q-btn flat label="Batal" color="grey-7" v-close-popup />
          <q-btn color="primary" label="Buat" :loading="submitting" @click="submitCreate" />
        </q-card-actions>
      </q-card>
    </q-dialog>

    <!-- Rollover Result Dialog -->
    <q-dialog v-model="resultDialogOpen" persistent>
      <q-card style="min-width: 420px">
        <q-card-section class="bg-positive text-white">
          <div class="text-h6">Tahun Ajaran Berhasil Dibuat!</div>
        </q-card-section>
        <q-card-section v-if="rolloverResult" class="q-gutter-sm">
          <div><b>Dari:</b> {{ rolloverResult.from_period }}</div>
          <div><b>Ke:</b> {{ rolloverResult.to_period }}</div>
          <q-separator />
          <div><q-icon name="check" color="positive" /> Kelas disalin: <b>{{ rolloverResult.classes_copied }}</b></div>
          <div><q-icon name="check" color="positive" /> Siswa disalin: <b>{{ rolloverResult.students_copied }}</b></div>
          <div><q-icon name="check" color="positive" /> Pembelajaran disalin: <b>{{ rolloverResult.lessons_copied }}</b>
          </div>
          <div><q-icon name="school" color="orange" /> Siswa lulus: <b>{{ rolloverResult.graduates_count }}</b></div>
        </q-card-section>
        <q-card-actions align="right">
          <q-btn color="primary" label="OK" @click="resultDialogOpen = false" />
        </q-card-actions>
      </q-card>
    </q-dialog>
  </q-page>
</template>

<script setup>
import { ref, computed, onMounted } from 'vue'
import { useQuasar } from 'quasar'
import { AcademicPeriodService } from '@/services/admin/AcademicPeriodService'
import { useAcademicStore } from '@/stores/academic'

const $q = useQuasar()
const academicStore = useAcademicStore()

const periods = ref([])
const loading = ref(false)
const submitting = ref(false)

const createDialogOpen = ref(false)
const resultDialogOpen = ref(false)
const rolloverResult = ref(null)

const form = ref({
  academic_year: '',
  semester: 'GANJIL',
})

const semesterOptions = [
  { label: 'Ganjil', value: 'GANJIL' },
  { label: 'Genap', value: 'GENAP' },
]

const columns = [
  { name: 'academic_year', label: 'Tahun Ajaran', field: 'academic_year', align: 'left', sortable: true },
  { name: 'semester', label: 'Semester', field: 'semester', align: 'center' },
  { name: 'status', label: 'Status', field: 'is_active', align: 'center', style: 'width: 130px' },
  { name: 'created_at', label: 'Dibuat', field: 'created_at', align: 'left' },
  { name: 'actions', label: 'Aksi', align: 'center', style: 'width: 140px' },
]

const activePeriod = computed(() => periods.value.find((p) => p.is_active))

const loadPeriods = async () => {
  loading.value = true
  try {
    const res = await AcademicPeriodService.list()
    periods.value = res?.data?.data || []

    // ✅ Sinkronisasi store dengan periode AKTIF dari DB
    const active = periods.value.find((p) => p.is_active)
    if (
      active &&
      (academicStore.academic_year !== active.academic_year ||
        academicStore.semester !== active.semester)
    ) {
      academicStore.setPeriod(active.academic_year, active.semester)
    }
  } catch (err) {
    $q.notify({ type: 'negative', message: `Gagal memuat data: ${err.message}` })
    periods.value = []
  } finally {
    loading.value = false
  }
}

const suggestNextYear = () => {
  if (!activePeriod.value) return ''
  const parts = activePeriod.value.academic_year.split('/')
  if (parts.length !== 2) return ''
  const start = parseInt(parts[0], 10)
  if (isNaN(start)) return ''
  return `${start + 1}/${start + 2}`
}

const openCreateDialog = () => {
  form.value = {
    academic_year: suggestNextYear(),
    semester: 'GANJIL',
  }
  createDialogOpen.value = true
}

const submitCreate = async () => {
  const ay = String(form.value.academic_year || '').trim()
  if (!/^\d{4}\/\d{4}$/.test(ay)) {
    $q.notify({ type: 'warning', message: 'Format tahun ajaran harus YYYY/YYYY' })
    return
  }

  $q.dialog({
    title: 'Konfirmasi',
    message: `Buat tahun ajaran <b>${ay} — ${form.value.semester}</b>?<br><br>Sistem akan menyalin semua kelas, siswa, dan pembelajaran dari periode aktif dengan auto-naik-tingkat.`,
    html: true,
    cancel: { label: 'Batal', flat: true },
    ok: { label: 'Ya, Buat', color: 'primary' },
    persistent: true,
  }).onOk(async () => {
    submitting.value = true
    try {
      const res = await AcademicPeriodService.create({
        academic_year: ay,
        semester: form.value.semester,
      })
      rolloverResult.value = res?.data?.data
      createDialogOpen.value = false
      resultDialogOpen.value = true

      // Update store agar semua halaman langsung mengikuti periode baru
      academicStore.setPeriod(ay, form.value.semester)

      await loadPeriods()
    } catch (err) {
      const errCode = err?.response?.data?.error
      const msg = errCode === 'period_exists'
        ? 'Tahun ajaran tersebut sudah ada.'
        : err?.response?.data?.message || 'Gagal membuat tahun ajaran.'
      $q.notify({ type: 'negative', message: msg })
    } finally {
      submitting.value = false
    }
  })
}

const confirmActivate = (period) => {
  $q.dialog({
    title: 'Aktifkan Periode',
    message: `Aktifkan <b>${period.academic_year} — ${period.semester}</b>?<br><br>Semua halaman akan menampilkan data periode ini.`,
    html: true,
    cancel: { label: 'Batal', flat: true },
    ok: { label: 'Aktifkan', color: 'primary' },
    persistent: true,
  }).onOk(async () => {
    try {
      // Backend: activate via set-period? Atau via endpoint yang sama?
      // Untuk saat ini, store diupdate lokal + butuh endpoint khusus
      // Sementara: update store dan reload — tidak ada endpoint switch aktif di backend saat ini
      academicStore.setPeriod(period.academic_year, period.semester)
      $q.notify({
        type: 'positive',
        message: `Periode ${period.academic_year} — ${period.semester} diaktifkan di sesi ini.`,
      })
      await loadPeriods()
    } catch (err) {
      $q.notify({ type: 'negative', message: `Gagal mengaktifkan periode. ${err}` })
    }
  })
}

onMounted(loadPeriods)
</script>
